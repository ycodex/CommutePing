# Public mobile configuration. Supabase publishable keys are designed to be
# embedded in clients; all sensitive access is enforced by Row Level Security.
# Never place a service-role key or provider secret in an EXPO_PUBLIC variable.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Optional provider overrides. HTTPS is required.
EXPO_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
EXPO_PUBLIC_ROUTING_BASE_URL=https://router.project-osrm.org
