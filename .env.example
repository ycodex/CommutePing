# Build-time only. Restrict this key in Google Cloud to Maps SDK for Android,
# package in.commuteping.app, and the SHA-1 certificate used by the EAS build.
GOOGLE_MAPS_ANDROID_API_KEY=

# Optional for Google Maps on iOS. Restrict this separate key to Maps SDK for iOS
# and bundle identifier in.commuteping.app. Without it, iOS uses Apple Maps.
GOOGLE_MAPS_IOS_API_KEY=
