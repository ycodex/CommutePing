# Set these with `supabase secrets set`; never commit real values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SECRET

# Optional: required only if Expo push access security is enabled.
EXPO_ACCESS_TOKEN=

# A random server-only value used by the scheduled outbox dispatcher.
CRON_SECRET=REPLACE_WITH_RANDOM_SECRET

# Optional comma-separated origins for a future authenticated web client.
ALLOWED_ORIGINS=
